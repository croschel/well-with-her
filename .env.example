# Payload CMS (Ticket 1)
# Use the Neon `development` branch's connection string here — never
# `production`. Local dev/seed scripts write freely; `production` holds real
# content the wife edits and must only ever be touched by the deployed site.
# See docs/vercel-deploy-checklist.md.
DATABASE_URI=
PAYLOAD_SECRET=

# Media storage — Vercel Blob (Ticket 1)
BLOB_READ_WRITE_TOKEN=

# Revalidation escape hatch (Ticket 9)
REVALIDATE_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pinterest domain verification meta tag (Ticket 6) — value from Pinterest's
# business account "Claim website" flow; the tag only renders when this is set
PINTEREST_DOMAIN_VERIFY_CODE=

# Analytics (Ticket 10)
# Direct GA4 gtag script. Keep GA4 direct: do NOT also add a GA4 config tag in
# the GTM container while this is set, or every page view counts twice.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Direct Pinterest tag script. Leave UNSET in production: the Pinterest tag
# (ID 2613820112424) runs through GTM via the "Pinterest Tag" template.
# Setting this AND the GTM Pinterest tag double-fires Pinterest.
NEXT_PUBLIC_PINTEREST_TAG_ID=

# Google Tag Manager (Ticket 16) — container ID, e.g. GTM-XXXXXXX. Loaded in
# the (site) layout only, never /admin. Inlined at build time, so changing it
# requires a redeploy. Renders nothing when unset.
NEXT_PUBLIC_GTM_ID=
